# Keep the upstream Mathematica fixtures byte-for-byte for source hashes.
fixtures/amflow-2.0/*.wl -whitespace

# Preserve byte-identical upstream fixtures and raw profiler output.
fixtures/performance/*.wl -whitespace
reports/performance/*-profile.txt -whitespace

# Preserve raw timing/profiler evidence for standalone native-root reproducers.
repros/symbolica-close-root-isolation/*.log -whitespace
repros/symbolica-close-root-isolation/perf-report.txt -whitespace

# Unified patches use a literal space for empty context lines.
scripts/patches/*.patch whitespace=-blank-at-eol
