+
+#[cfg(test)]
+mod exact_division_tests {
+    use crate::{prelude::*, tensors::matrix::Matrix};
+
+    fn field() -> AtomField {
+        AtomField {
+            statistical_zero_test: false,
+            cancel_check_on_division: true,
+            custom_normalization: Some(Box::new(|a: AtomView<'_>, out: &mut Atom| {
+                *out = a.together().cancel();
+                true
+            })),
+        }
+    }
+
+    fn nonzero_denominator() -> Atom {
+        parse!("x+(10^40-10^40*y)/10^40")
+    }
+
+    #[test]
+    fn exact_division_and_inverse_honor_configured_zero_test() {
+        let f = field();
+        let denominator = nonzero_denominator();
+        assert!(!f.is_zero(&denominator));
+        for value in [
+            f.try_div(&Atom::num(1), &denominator),
+            f.try_inv(&denominator),
+        ] {
+            let value = value.expect("exact nonzero denominator must remain invertible");
+            assert!(
+                (value * &denominator - Atom::num(1))
+                    .together()
+                    .cancel()
+                    .is_zero()
+            );
+        }
+        assert!(f.try_inv(&Atom::num(0)).is_none());
+        assert!(f.try_div(&Atom::num(1), &Atom::num(0)).is_none());
+    }
+
+    #[test]
+    fn exact_bareiss_preserves_nonzero_unexpanded_pivot() {
+        let denominator = nonzero_denominator();
+        let mut matrix = Matrix::identity(4, field());
+        matrix[(0, 0)] = denominator.clone();
+        let determinant = matrix.det().expect("square matrix");
+        assert!((determinant - denominator).together().cancel().is_zero());
+    }
+}
