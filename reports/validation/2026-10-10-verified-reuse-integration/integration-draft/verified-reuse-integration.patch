+    #[test]
+    fn verified_internal_composition_retains_physical_storage_checks() {
+        let domain = IndexDomain::new([
+            IndexBounds::new(Some(2), None).unwrap(),
+            IndexBounds::fixed(0),
+            IndexBounds::fixed(0),
+        ])
+        .unwrap();
+        let build = |physical_arity| {
+            GuardedContext::new_with_physical_arity(
+                measure(),
+                [
+                    IndexRole::RequiredCut,
+                    IndexRole::Occupation,
+                    IndexRole::Ordinary,
+                ],
+                [
+                    symbol!("verified_wrapper_cut"),
+                    symbol!("verified_wrapper_occupation"),
+                    symbol!("verified_wrapper_tail"),
+                ],
+                vec![],
+                vec![GuardedIdentity {
+                    id: "verified-wrapper-padded-source".into(),
+                    terms: vec![
+                        GuardedIdentityTerm {
+                            shift: [0, 0, 0],
+                            coefficient: Atom::one(),
+                        },
+                        GuardedIdentityTerm {
+                            shift: [-1, 1, 0],
+                            coefficient: -Atom::one(),
+                        },
+                    ],
+                    domain: domain.clone(),
+                    nonzero_conditions: vec![],
+                }],
+                physical_arity,
+            )
+            .unwrap()
+        };
+        let padded = build(2);
+        let empty = || {
+            padded
+                .discover(Vec::new(), [], Default::default())
+                .unwrap()
+                .program
+        };
+        let physical = build(3)
+            .discover(Vec::new(), [], Default::default())
+            .unwrap()
+            .program;
+        assert!(empty().union_verified(physical, [], 0).is_err());
+        for invalid in [[1, 1, 1], [0, 0, 0], [1, -1, 0]] {
+            assert!(empty().with_terminals_verified([invalid], 0).is_err());
+            assert!(empty().union_verified(empty(), [invalid], 0).is_err());
+        }
+        let valid = empty().with_terminals_verified([[1, 1, 0]], 0).unwrap();
+        let bytes = valid.encode(Default::default()).unwrap();
+        assert_eq!(
+            padded
+                .decode(&bytes, Default::default())
+                .unwrap()
+                .native()
+                .terminals(),
+            &BTreeSet::from([[1, 1, 0]])
+        );
+    }
