+    #[test]
+    fn verified_internal_composition_matches_public_replay_and_decode() {
+        let context = context(measure());
+        let make = || {
+            context
+                .discover(
+                    vec![
+                        IndexDomain::new([
+                            IndexBounds::new(Some(2), None).unwrap(),
+                            IndexBounds::fixed(0),
+                        ])
+                        .unwrap(),
+                    ],
+                    [[1, 1]],
+                    Default::default(),
+                )
+                .unwrap()
+                .program
+        };
+        let verified = make().union_verified(make(), [[1, 1]], 2).unwrap();
+        let replayed = make().union_replayed(make(), [[1, 1]], 2).unwrap();
+        assert_eq!(
+            verified.encode(Default::default()).unwrap(),
+            replayed.encode(Default::default()).unwrap()
+        );
+        let reduced = verified.reduce([2, 0], Default::default()).unwrap();
+        assert_eq!(reduced.terms, BTreeMap::from([([1, 1], Atom::one())]));
+        assert!(reduced.unresolved.is_empty());
+        assert!(
+            reduced
+                .nonzero_conditions
+                .contains(&Atom::var(symbol!("guarded_test_x")))
+        );
+        let verified = verified.with_terminals_verified([], 2).unwrap();
+        let replayed = replayed.with_terminals_replayed([], 2).unwrap();
+        let bytes = verified.encode(Default::default()).unwrap();
+        assert_eq!(bytes, replayed.encode(Default::default()).unwrap());
+        let restored = context.decode(&bytes, Default::default()).unwrap();
+        let uncovered = restored.reduce([2, 0], Default::default()).unwrap();
+        assert!(uncovered.terms.is_empty());
+        assert_eq!(uncovered.unresolved.len(), 1);
+        assert_eq!(uncovered.unresolved[0].integral, [1, 1]);
+        assert_eq!(uncovered.unresolved[0].coefficient, Atom::one());
+        assert_eq!(
+            uncovered.unresolved[0].reason,
+            GuardedApplicationFailure::NoApplicableRule
+        );
+        assert_eq!(uncovered.nonzero_conditions, reduced.nonzero_conditions);
+        assert!(make().union_verified(make(), [], 1).is_err());
+        assert!(make().with_terminals_verified([], 0).is_err());
+        let mut changed = measure();
+        changed.branch.push_str("-different-branch");
+        let foreign = self::context(changed)
+            .discover(Vec::new(), [], Default::default())
+            .unwrap()
+            .program;
+        assert!(make().union_verified(foreign, [], 2).is_err());
+    }
