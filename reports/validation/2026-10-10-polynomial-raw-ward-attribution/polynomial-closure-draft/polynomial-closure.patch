+    #[test]
+    fn shifted_polynomial_boundary_cancels_every_positive_completion_image() {
+        let definition: DensityInput = serde_json::from_str(include_str!(
+            "../../examples/finite_density/massless_three_loop_chain.json"
+        ))
+        .unwrap();
+        let input = definition.prepare().unwrap();
+        let family = input.occupied_cut(&[0], 16).unwrap().at_physical_masses();
+        let shifted = (0..family.physical_slots())
+            .filter(|s| family.roles()[*s] == IndexRole::Ordinary)
+            .collect::<Vec<_>>();
+        let eta = symbol!("polynomial_boundary_draft::eta");
+        let dimension = Atom::var(symbol!("polynomial_boundary_draft::D"));
+        let measure = family.deformed_measure::<12>(eta, &shifted).unwrap();
+        let completions = family.polynomial_compact_energy_completions().unwrap();
+        assert_eq!(completions.len(), 1);
+        let indices = std::array::from_fn(|i| symbol!(format!("polynomial_boundary_draft::a_{i}")));
+        let (u, boost) = measure
+            .polynomial_closure_sources(
+                family.loops(),
+                family.physical_slots(),
+                family.input_slots(),
+                &completions,
+                &dimension,
+                &indices,
+                16,
+            )
+            .unwrap();
+        let slot = completions[0].slot();
+        let mut cancelled_positive = 0;
+        for row in u.iter().chain(&boost) {
+            for power in [-1, -2] {
+                let mut base = [0_i64; 12];
+                for i in 0..family.physical_slots() {
+                    base[i] = if measure.roles()[i] == IndexRole::RequiredCut {
+                        2
+                    } else {
+                        1
+                    };
+                }
+                for i in 0..measure.physical_arity() {
+                    if measure.roles()[i] == IndexRole::Occupation {
+                        base[i] = row.domain.bounds()[i].lower().unwrap();
+                    }
+                }
+                base[slot] = power;
+                assert!(row.domain.contains(&base));
+                let mut invalid = base;
+                invalid[slot] = 0;
+                assert!(!row.domain.contains(&invalid));
+                let replacements = indices
+                    .iter()
+                    .zip(base)
+                    .map(|(&s, n)| (Atom::var(s), Atom::num(n)))
+                    .collect::<BTreeMap<_, _>>();
+                for term in &row.terms {
+                    let coefficient = crate::family::substitute(&term.coefficient, &replacements)
+                        .expand()
+                        .together()
+                        .cancel();
+                    let positive = (family.physical_slots()..family.input_slots())
+                        .any(|s| base[s] + i64::from(term.shift[s]) > 0);
+                    if positive {
+                        assert!(coefficient.is_zero());
+                        cancelled_positive += 1;
+                    }
+                    if !coefficient.is_zero() {
+                        for i in family.physical_slots()..family.input_slots() {
+                            assert!(base[i] + i64::from(term.shift[i]) <= 0);
+                        }
+                        for i in 0..measure.physical_arity() {
+                            if measure.roles()[i] == IndexRole::Occupation {
+                                assert!(base[i] + i64::from(term.shift[i]) >= 0);
+                            }
+                        }
+                        assert!(
+                            term.shift[measure.physical_arity()..]
+                                .iter()
+                                .all(|n| *n == 0)
+                        );
+                    }
+                }
+            }
+        }
+        assert!(
+            cancelled_positive > 0,
+            "test must encounter a formal positive image at the old zero-energy-power boundary"
+        );
     }
