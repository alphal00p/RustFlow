+    /// Match exactly c E_a among ordinary completion factors for occupied a.
+    /// A sum/mixed energy, constant offset, virtual energy, nonordinary factor,
+    /// or zero coefficient receives no certificate. An absent map means no
+    /// shifted source for that slot; no reciprocal factor is introduced.
+    pub(crate) fn polynomial_compact_energy_completions(
+        &self,
+    ) -> Result<Vec<PolynomialEnergyCompletion>> {
+        let scalar = self
+            .loops
+            .checked_add(1)
+            .and_then(|n| self.loops.checked_mul(n))
+            .map(|n| n / 2)
+            .ok_or_else(|| Error::Limit("polynomial energy coordinate overflow".into()))?;
+        if self.coordinates.len()
+            != scalar
+                .checked_add(self.loops)
+                .ok_or_else(|| Error::Limit("polynomial energy coordinate count overflow".into()))?
+            || self.physical_slots > self.input_slots
+            || self.input_slots > self.factors.len()
+            || self.roles.len() != self.factors.len()
+        {
+            return Err(Error::InvalidInput(
+                "polynomial energy factor layout mismatch".into(),
+            ));
+        }
+        let mut result = Vec::new();
+        for shell in &self.shells {
+            if shell.loop_index >= self.loops {
+                return Err(Error::InvalidInput(
+                    "polynomial compact loop out of range".into(),
+                ));
+            }
+            let energy = &self.coordinates[scalar + shell.loop_index];
+            let AtomView::Var(v) = energy.as_view() else {
+                return Err(Error::InvalidInput(
+                    "polynomial compact energy is not a coordinate".into(),
+                ));
+            };
+            for slot in self.physical_slots..self.input_slots {
+                if self.roles[slot] != IndexRole::Ordinary {
+                    continue;
+                }
+                let factor = &self.factors[slot];
+                let Ok(c) = Rational::try_from(
+                    factor
+                        .derivative(v.get_symbol())
+                        .together()
+                        .cancel()
+                        .as_view(),
+                ) else {
+                    continue;
+                };
+                if c.is_zero()
+                    || !(factor - Atom::num(c.clone()) * energy)
+                        .expand()
+                        .together()
+                        .cancel()
+                        .is_zero()
+                {
+                    continue;
+                }
+                result.push(PolynomialEnergyCompletion {
+                    loop_index: shell.loop_index,
+                    slot,
+                    coefficient: c,
+                });
+            }
+        }
+        Ok(result)
+    }
