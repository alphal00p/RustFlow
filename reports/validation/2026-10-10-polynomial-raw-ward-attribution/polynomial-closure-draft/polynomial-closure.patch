+/// Simultaneously reindex one complete identity: old n = new n + shift.
+/// Caller must intersect the *old* source with its physically admitted domain
+/// first. Preserve unsimplified coefficients/conditions so raw denominator
+/// requirements remain visible to GuardedContext's existing pole collection.
+fn shift_guarded_identity<const N: usize>(
+    mut source: GuardedIdentity<N>,
+    indices: &[Symbol; N],
+    shift: [i16; N],
+    id: String,
+) -> Result<GuardedIdentity<N>> {
+    if indices
+        .iter()
+        .collect::<std::collections::BTreeSet<_>>()
+        .len()
+        != N
+    {
+        return Err(Error::InvalidInput(
+            "shifted source indices are not distinct".into(),
+        ));
+    }
+    let replacements = indices
+        .iter()
+        .zip(shift)
+        .filter(|(_, n)| *n != 0)
+        .map(|(&s, n)| (Atom::var(s), Atom::var(s) + Atom::num(n)))
+        .collect::<BTreeMap<_, _>>();
+    for term in &mut source.terms {
+        for (degree, delta) in term.shift.iter_mut().zip(shift) {
+            *degree = degree
+                .checked_add(delta)
+                .ok_or_else(|| Error::Limit("polynomial identity shift overflow".into()))?;
+        }
+        term.coefficient = crate::family::substitute(&term.coefficient, &replacements);
+    }
+    for condition in &mut source.nonzero_conditions {
+        *condition = crate::family::substitute(condition, &replacements);
+    }
+    source.domain = source
+        .domain
+        .pullback(&shift.map(i64::from))
+        .map_err(|e| Error::InvalidInput(e.to_string()))?;
+    source.id = id;
+    Ok(source)
+}
