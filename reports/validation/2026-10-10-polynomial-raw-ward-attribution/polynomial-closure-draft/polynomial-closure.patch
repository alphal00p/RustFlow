+        }
+        let polynomial =
+            IndexDomain::new(bounds).map_err(|e| Error::InvalidInput(e.to_string()))?;
+        let max_rows = completions
+            .len()
+            .checked_mul(domain_budget)
+            .and_then(|n| n.checked_mul(2))
+            .ok_or_else(|| Error::Limit("polynomial source total row budget overflow".into()))?;
