+                .checked_add(source.terms.len())
+                .ok_or_else(|| Error::Limit("raw Ward emitted term count overflow".into()))?;
+            if total_terms > total_bound {
+                return Err(Error::Limit("raw Ward total term budget exhausted".into()));
