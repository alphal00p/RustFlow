+fn finish_direct_lookahead<const N: usize>(
+    mut candidate: RuleCandidate<N>,
+    stats: &mut SearchStats,
+    completion: &'static str,
+) -> RuleCandidate<N> {
+    if let Some(extra) = &mut stats.direct_lookahead {
+        extra.completion = completion;
+    }
+    // Aggregate attempted work is retained, but the proof kind/size belongs
+    // to the selected candidate, not a rejected indirect alternative.
+    stats.direct_hit = candidate.stats.direct_hit;
+    stats.exact_trace_rows = candidate.stats.exact_trace_rows;
+    candidate.stats = *stats;
+    candidate
 }
 
