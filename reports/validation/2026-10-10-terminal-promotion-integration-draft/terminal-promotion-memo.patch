+        max_program_bytes: usize::MAX,
+        max_sections: usize::MAX,
+        max_collection_entries: usize::MAX,
+        max_state_bytes: usize::MAX,
+        max_atom_bytes: usize::MAX,
+        max_total_atom_bytes: usize::MAX,
+        exact_algebra: ExactAlgebraLimits {
