  "normalization": {
    "measure": "L=N-1 independent integration momenta; normalized positive-energy massless cuts, oriented sum equals declared future channel; no flux or identical-particle factor.",
    "base_owner": "HEPKit Kinematics::two_body_phase_space at D=4, same existing dimensional continuation as PreparedTwoBodyPhaseSpace.",
    "formula": "C2^(N-1)/(2*pi)^(N-2)*Gamma(a)*Gamma(2a)^(N-1)/(Gamma((N-1)*a)*Gamma(Na))*s^((N-1)*a-1)*abs(det routing)^(-D), a=(D-2)/2.",
    "derivation": "Repeated dt/(2*pi) phase-space factorization gives Cn=C2*C(n-1)/(2*pi)*Beta((n-2)*a,2a). Gamma factors telescope. Re(a)>0 establishes the convolution; formula then supplies meromorphic continuation away from exceptional samples.",
    "native_owners": [
      "HEPKit two-body measure",
      "HEPKit three-body Dalitz density used as independent D4 Laurent normalization",
      "Symbolica Matrix<Q>::det for exact affine routing",
      "RustRed cut-aware reductions and original nonzero conditions",
      "Existing shared RustFlow sample evaluation and independent-grid/precision Laurent fitting",
      "Symbolica MPFR powers/gamma; no f64"
    ],
    "removable_case": "N=2 gamma quotient cancels exactly, preserving finite D=2 value.",
    "fit_bound": "New terminal starts at -2L, lowered further by maximal exact epsilon pole order of reduction weights. Existing two-body leading0 convention remains unchanged."
  },
  "new_coverage": [
    "L2/L3 massless unit volumes at exact epsilon1/13 and1/17 versus separately prepared automatic uncut AMF discontinuities;20relative-digit assertion.",
    "Higher working precision/order reevaluations compared at50digits; no50digit physical-accuracy claim.",
    "Native cut-aware IBP reduction of L2 raised cut and ISP numerator versus independent ordinary AMF discontinuity; missing required cuts zero.",
    "Public20digit Laurent fit of L2 unit volume through epsilon0 versus native three-body Dalitz density times exact triangle area; independent grids/refinement.",
    "L1 throughL4 unit volumes: nonunit determinants, external affine shifts, cut permutations, backward channel and pinched cuts.",
    "Two-external-vector channel at D0=6 compared to automatic ordinary bubble discontinuity.",
    "Exact D=2 finite N=2 case avoids removable gamma singularity.",
    "Incomplete or wrong residual reductions rejected; epsilon guard evaluated; extra1/epsilon^3 weight extends L2 bound to-7.",
    "Massive, mixed-cut and extra-ISP-denominator inputs rejected."
  ],
  "limits": [
    "Other exceptional gamma samples can return typed numerical errors; no arbitrary removable-pole continuation engine is added.",
    "Raised/numerator support requires actual exact cut-reduction closure; unsupported backends/residuals do not become accepted basis integrals.",
    "Massive N>2, mixed cuts, general cut boundary recursion, cut-preserving partial fractions and singular timelike thresholds remain excluded.",
    "Finite-sample L3 evidence is separate from the L2 full Laurent regression; no full L3 Laurent acceptance is claimed here.",
    "Full AMFlow/DiffExp feature and broad performance parity remain incomplete.",
    "Nine long scientific tests were compiled but explicitly ignored; historical full-system numerical runs were not repeated by this release gate."
  ],
