+/// Work performed by the optional batch engine, separate from the original
+/// logical counters. Unknown partial work inside native Err is never estimated.
+#[derive(Clone, Debug)]
+pub struct WeightedUnitBatchDiagnostics {
+    pub calls: usize,
+    pub input_units: usize,
+    pub prefetched_native_calls: usize,
+    pub fallback_native_calls: usize,
+    pub native_calls_returning_error: usize,
+    pub item_errors: usize,
+    pub logical_accounted_units: usize,
+    pub uncommitted_units: usize,
+    pub executed_cache_hits: usize,
+    pub executed_cache_misses: usize,
+    pub peak_private_workers: usize,
+    pub simultaneous_native_calls_bound: usize,
+    pub actual_known_rule_applications: u128,
+    pub speculative_known_rule_applications: u128,
+    pub actual_application_count_complete: bool,
+}
+impl Default for WeightedUnitBatchDiagnostics {
+    fn default() -> Self {
+        Self {
+            calls: 0,
+            input_units: 0,
+            prefetched_native_calls: 0,
+            fallback_native_calls: 0,
+            native_calls_returning_error: 0,
+            item_errors: 0,
+            logical_accounted_units: 0,
+            uncommitted_units: 0,
+            executed_cache_hits: 0,
+            executed_cache_misses: 0,
+            peak_private_workers: 0,
+            simultaneous_native_calls_bound: 0,
+            actual_known_rule_applications: 0,
+            speculative_known_rule_applications: 0,
+            actual_application_count_complete: true,
+        }
+    }
+}
