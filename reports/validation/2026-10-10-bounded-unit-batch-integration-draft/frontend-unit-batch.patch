+    /// Validate only through the first invalid input. Earlier valid units are
+    /// executed before that validation error is appended to the ordered result.
+    /// Conversion errors remain per-item errors so all executed work is visible.
+    pub(crate) fn reduce_batch_memoized(
+        &self,
+        targets: &[[i64; N]],
+        limits: GuardedReductionLimits,
+        batch: GuardedUnitBatchLimits,
+    ) -> Result<GuardedAtomBatch<N>> {
+        if batch.max_workers == 0
+            || batch.max_in_flight == 0
+            || batch.max_workers > batch.max_in_flight
+            || targets.len() > batch.max_in_flight
+        {
+            return Err(Error::InvalidInput(
+                "invalid independent unit batch bounds".into(),
+            ));
+        }
+        let mut prefix = targets.len();
+        let mut validation_error = None;
+        for (index, target) in targets.iter().enumerate() {
+            if let Err(error) = validate_storage_label(target, self.physical_arity) {
+                prefix = index;
+                validation_error = Some(error);
+                break;
+            }
+        }
+        let native = self
+            .native
+            .reduce_batch_memoized(&targets[..prefix], limits, batch)
+            .map_err(|error| Error::Reduction(error.to_string()))?;
+        let mut items = native
+            .items
+            .into_iter()
+            .zip(native.memo_usage_after)
+            .map(|(item, usage)| {
+                let result = item
+                    .map_err(|error| Error::Reduction(error.to_string()))
+                    .and_then(|item| {
+                        self.convert_reduction(item.reduction)
+                            .map(|reduced| (reduced, item.cache_hit))
+                    });
+                GuardedAtomBatchItem {
+                    result,
+                    memo_usage_after: usage,
+                }
+            })
+            .collect::<Vec<_>>();
+        if let Some(error) = validation_error {
+            items.push(GuardedAtomBatchItem {
+                result: Err(error),
+                memo_usage_after: None,
+            });
+        }
+        Ok(GuardedAtomBatch {
+            items,
+            stats: native.stats,
+        })
     }
 
