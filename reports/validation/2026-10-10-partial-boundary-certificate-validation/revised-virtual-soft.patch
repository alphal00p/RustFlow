+#[derive(Debug)]
+pub(super) struct OrdinaryVirtualZero {
+    family: IntegralFamily,
+    integral: Integral,
+    coefficient: Atom,
+    native: Certificate,
+    nonzero_conditions: Vec<Atom>,
+}
+#[derive(Debug)]
+pub(super) struct VirtualSoftZero {
+    source_virtual_loops: Vec<usize>,
+    source_region_space: RegionFactorSpace,
+    distributions: Vec<OccupiedBoundaryDistribution>,
+    /// old_virtual = new_virtual - translation * compact/external vectors.
+    translation: Vec<Vec<Atom>>,
+    /// Nonempty only for the unrestricted-polynomial null-direction case.
+    null_directions: Vec<Vec<Atom>>,
+    denominator_rows: Vec<Vec<Atom>>,
+    original_expression: Atom,
+    translated_expression: Atom,
+    coordinate_substitutions: BTreeMap<Atom, Atom>,
+    ordinary_proofs: Vec<OrdinaryVirtualZero>,
+    nonzero_conditions: Vec<Atom>,
+}
+
+impl VirtualSoftZero {
+    pub(super) fn expression(&self) -> &Atom {
+        &self.original_expression
+    }
+    pub(super) fn region_space(&self) -> &RegionFactorSpace {
+        &self.source_region_space
+    }
+    pub(super) fn distributions(&self) -> &[OccupiedBoundaryDistribution] {
+        &self.distributions
+    }
+
+    pub(super) fn nonzero_conditions(&self) -> &[Atom] {
+        &self.nonzero_conditions
+    }
+    pub(super) fn report(&self) -> serde_json::Value {
+        serde_json::json!({
+            "scope":"ordinary unrestricted virtual factor only; requires caller-bound compact origin/endpoint permit",
+            "source_virtual_loops":self.source_virtual_loops,
+            "distributions":self.distributions.iter().map(|d|serde_json::json!({"source_loop_index":d.source_loop_index,"mass_squared":d.shell.mass_squared.to_string(),"chemical_potential":d.shell.chemical_potential.to_string(),"cut_index":d.cut_index,"upper_index":d.upper_index,"lower_index":d.lower_index})).collect::<Vec<_>>(),
+            "source_loop_indices":self.source_region_space.source_loop_indices,
+            "source_coordinate_indices":self.source_region_space.source_coordinate_indices,
+            "translation":self.translation.iter().map(|r|r.iter().map(AtomCore::to_canonical_string).collect::<Vec<_>>()).collect::<Vec<_>>(),
+            "null_directions":self.null_directions.iter().map(|r|r.iter().map(AtomCore::to_canonical_string).collect::<Vec<_>>()).collect::<Vec<_>>(),
+            "positive_denominator_momentum_rows":self.denominator_rows.iter().map(|r|r.iter().map(AtomCore::to_canonical_string).collect::<Vec<_>>()).collect::<Vec<_>>(),
+            "original_expression":self.original_expression.to_canonical_string(),
+            "translated_expression":self.translated_expression.to_canonical_string(),
+            "coordinate_substitutions":self.coordinate_substitutions.iter().map(|(a,b)|(a.to_canonical_string(),b.to_canonical_string())).collect::<BTreeMap<_,_>>(),
+            "nonzero_conditions":self.nonzero_conditions.iter().map(AtomCore::to_canonical_string).collect::<Vec<_>>(),
+            "ordinary_proofs":self.ordinary_proofs.iter().map(|p|serde_json::json!({
+                "family_fingerprint":p.native.family_fingerprint(),
+                "ordinary_loops":p.family.loops,"external_coefficient_vectors":p.family.external,
+                "integral":p.integral.0,"coefficient":p.coefficient.to_canonical_string(),
+                "raw_sector":p.native.raw_sector().active_bits(),"effective_sector":p.native.effective_sector().active_bits(),
+                "parameter_order":p.native.active_parameter_order(),"rank":p.native.rank(),"exponent_row_count":p.native.exponent_row_count(),
+                "primitive_kernel":p.native.primitive_kernel().iter().map(ToString::to_string).collect::<Vec<_>>(),
+                "nonzero_conditions":p.nonzero_conditions.iter().map(AtomCore::to_canonical_string).collect::<Vec<_>>()
+            })).collect::<Vec<_>>()
+        })
